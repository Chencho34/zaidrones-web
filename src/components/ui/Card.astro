---
interface Props {
  class?: string;
  hover?: boolean;
  bgImage?: string;
}

const { class: className = "", hover = true, bgImage, ...rest  } = Astro.props;
---

<div
  style={bgImage ? `background-image: url(${bgImage}); background-size: cover; background-position: center;` : ""}
  class:list={[
    `rounded-xl border border-border bg-white p-6`,
    hover && "transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1",
    className,
  ]}
  {...rest}
>
  <slot />
</div>
