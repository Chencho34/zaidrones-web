---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

interface Props {
  img?: string;
  index?: string;
  title: string;
  description: string;
  features?: string[];
  href: string;
  icon?: AstroComponentFactory;
  badge?: string;
  featured?: boolean;
}

const { img, index, title, description, features, href, icon: Icon, badge, featured = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group relative min-h-115 rounded-sm overflow-hidden block focus-visible:outline-offset-4",
    featured && "ring-1 ring-accent/60",
  ]}
>
  <div
    class="absolute inset-0 bg-cover bg-center scale-100 group-hover:scale-110 transition-transform duration-700"
    style={`background-image:url('${img}')`}
    role="presentation"
  />

  <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/70 to-slate-950/20"></div>

  <div class="relative h-full flex flex-col p-7 text-white min-h-115">
    <div class="flex items-start justify-between mb-8">
      <span class="font-mono text-[11px] tracking-[0.2em] text-accent">{index}</span>
      {badge && (
        <span class:list={[
          "font-mono text-[10px] tracking-[0.16em] uppercase px-2 py-1 border",
          featured ? "border-accent text-accent" : "border-white/25 text-white/70",
        ]}>
          {badge}
        </span>
      )}
    </div>

    {Icon && (
      <div class="w-11 h-11 border border-white/25 bg-white/10 backdrop-blur-sm flex items-center justify-center mb-5">
        <Icon />
      </div>
    )}

    <h3 class="text-2xl font-semibold tracking-tight mb-3">{title}</h3>
    <p class="text-sm text-white/75 leading-relaxed mb-5">{description}</p>
    <ul class="space-y-1.5 mb-6 text-sm text-white/85">
      {features?.map((feature) => (
        <li class="flex items-center gap-2">
          <span class="text-accent text-xs" aria-hidden="true">▸</span>
          {feature}
        </li>
      ))}
    </ul>
    <span class="mt-auto inline-flex items-center gap-2 font-mono text-xs tracking-[0.14em] uppercase text-white/70 group-hover:text-accent group-hover:gap-3 transition-all">
      Conocer más
      <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
