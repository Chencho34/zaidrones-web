---
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Button from './Button.astro';

interface Props {
  img?: string;
  title: string;
  description: string;
  features?: string[];
  href: string;
  icon?: AstroComponentFactory;
}

const { img, title, description, features, href, icon: Icon } = Astro.props;
---

<div class="group relative min-h-115 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300">
  <!-- bg-image -->
  <div
    class="absolute inset-0 bg-cover bg-center scale-100 group-hover:scale-110 transition-transform duration-500"
    style=`background-image:url('${img}')`>
  </div>

  <!-- overlay -->
  <div class="absolute inset-0 bg-linear-to-t from-slate-950/95 via-slate-950/55 to-slate-950/10"></div>

  <!-- content-card -->
  <div class="relative h-full flex flex-col justify-start p-7 text-white">
    <div class="w-11 h-11 rounded-xl bg-white/15 border border-white/30 backdrop-blur-sm flex items-center justify-center text-xl mb-4">
      { Icon && <Icon /> }
    </div>
    <h3 class="text-xl font-bold mb-2">{title}</h3>
    <p class="text-sm text-white/85 leading-relaxed mb-4">{description}</p>
    <ul class="space-y-1.5 mb-5 text-sm text-white/90">
      {
        features?.map((feature) => (
          <li class="flex items-center gap-2">
            <span class="text-accent font-bold text-xs">✓</span>
            {feature}
          </li>
        ))
      }
    </ul>
    <a href={href} class="inline-flex  mt-auto items-center gap-1.5 text-sm font-semibold border-b border-white/60 w-fit pb-0.5 hover:gap-2.5 hover:border-accent hover:text-accent transition-all">
      Conocer más →
    </a>
  </div>
</div>
