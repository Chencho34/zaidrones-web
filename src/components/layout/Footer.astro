---
const footerLinks = {
  servicios: [
    { label: "Vigilancia 24/7", href: "#servicio-administrado" },
    { label: "Ortomosaico", href: "#servicios" },
    { label: "Nube de Puntos", href: "#servicios" },
    { label: "Inspección", href: "#servicios" },
    { label: "Capacitación", href: "#servicios" },
  ],
  empresa: [
    { label: "Nosotros", href: "#" },
    { label: "Proyectos", href: "#proyectos" },
    { label: "Blog", href: "#" },
    { label: "Contacto", href: "#contacto" },
  ],
  equipo: [
    { label: "DJI Matrice 400", href: "#equipo" },
    { label: "DJI Matrice 4T", href: "#equipo" },
    { label: "DJI Matrice 4E", href: "#equipo" },
    { label: "DJI Dock 3", href: "#equipo" },
  ],
};
---

<footer id="contacto" class="bg-background-light-dark text-text-inverse pt-16 pb-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-text-inverse/10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="text-xl font-bold tracking-tight">
          <span class="text-primary">Zai</span>Drones
        </a>
        <p class="mt-4 text-sm text-text-inverse/60 leading-relaxed max-w-sm">
          Drones profesionales para seguridad, inspección y captura de datos. Distribuidor oficial DJI Enterprise en México con +12 años de experiencia.
        </p>
        <div class="mt-6 flex items-center gap-4">
          <a href="tel:+528123787930" class="text-sm text-text-inverse/60 hover:text-primary transition-colors">
            (81) 2378 7930
          </a>
          <span class="text-text-inverse/20">|</span>
          <a href="tel:+528111000207" class="text-sm text-text-inverse/60 hover:text-primary transition-colors">
            (81) 1100 0207
          </a>
        </div>
        <p class="mt-2 text-sm text-text-inverse/40">
          Miravalle 215, Col. Miravalle, 64660, Monterrey, N.L.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-sm font-semibold text-text-inverse uppercase tracking-wider mb-4">Servicios</h3>
        <ul class="space-y-2">
          {footerLinks.servicios.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-inverse/50 hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text-inverse uppercase tracking-wider mb-4">Empresa</h3>
        <ul class="space-y-2">
          {footerLinks.empresa.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-inverse/50 hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text-inverse uppercase tracking-wider mb-4">Equipo</h3>
        <ul class="space-y-2">
          {footerLinks.equipo.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-text-inverse/50 hover:text-primary transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-text-inverse/30">
        &copy; {new Date().getFullYear()} ZaiDrones. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-4">
        <a href="#" class="text-text-inverse/30 hover:text-primary transition-colors" aria-label="Facebook">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="#" class="text-text-inverse/30 hover:text-primary transition-colors" aria-label="Instagram">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a href="#" class="text-text-inverse/30 hover:text-primary transition-colors" aria-label="LinkedIn">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
