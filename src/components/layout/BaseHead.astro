---
import ibmPlexFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url'
import onestFont from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url'

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "ZaiDrones | Drones profesionales DJI Enterprise en México",
  description = "Distribuidor oficial DJI Enterprise y Pix4D. Venta de equipo, servicios de datos aéreos y vigilancia perimetral 24/7 administrada. +12 años en Monterrey.",
  image = "/og-image.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, "https://zaidrones.com");

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "ZaiDrones",
  url: "https://zaidrones.com",
  image: "https://zaidrones.com/og-image.jpg",
  telephone: "+52-81-2378-7930",
  email: "contacto@zaidrones.com",
  foundingDate: "2014",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Miravalle 215, Col. Miravalle",
    addressLocality: "Monterrey",
    addressRegion: "Nuevo León",
    postalCode: "64660",
    addressCountry: "MX",
  },
  areaServed: "MX",
  description,
};
---

<link rel="preload" href={onestFont} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={ibmPlexFont} as="font" type="font/woff2" crossorigin />

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="ZaiDrones" />
<meta name="robots" content="index, follow" />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:locale" content="es_MX" />
<meta property="og:site_name" content="ZaiDrones" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
