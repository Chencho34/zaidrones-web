---
import SectionHeader from "./ui/SectionHeader.astro";

const cases = [
  {
    client: "Parque Industrial Monterrey",
    service: "Vigilancia Perimetral 24/7",
    description: "Implementación de DJI Dock 3 para monitoreo continuo de 50 hectáreas de infraestructura industrial.",
    result: "Reducción del 70% en incidentes de seguridad",
    industry: "Manufactura",
  },
  {
    client: "Constructora Regional",
    service: "Ortomosaico y Monitoreo",
    description: "Seguimiento semanal de avance de obra con mapas aéreos georreferenciados de alta resolución.",
    result: "Ahorro de 120 horas hombre/mes",
    industry: "Construcción",
  },
  {
    client: "Planta Energética",
    service: "Inspección Térmica",
    description: "Inspección de paneles solares con cámara térmica para detección de fallos en tiempo récord.",
    result: "Detección del 95% de anomalías ocultas",
    industry: "Energía",
  },
];
---

<section id="proyectos" class="py-20 md:py-28 bg-background">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      title="Casos de éxito"
      subtitle="Resultados reales que transforman la operación de nuestros clientes."
    />

    <div class="grid md:grid-cols-3 gap-8">
      {cases.map((c) => (
        <div class="group rounded-xl border border-border bg-white overflow-hidden transition-all duration-300 hover:shadow-lg hover:shadow-primary/5 hover:-translate-y-1">
          <!-- Placeholder image area -->
          <div class="h-48 bg-gradient-to-br from-background-dark to-text-alt relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-12 h-12 text-primary/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="absolute top-4 left-4">
              <span class="inline-block rounded-full bg-primary/20 text-primary text-xs font-semibold px-3 py-1">{c.industry}</span>
            </div>
          </div>

          <div class="p-6">
            <h3 class="text-lg font-bold text-text">{c.service}</h3>
            <p class="text-sm text-text-secondary mt-1">{c.client}</p>
            <p class="mt-3 text-sm text-text-secondary leading-relaxed">{c.description}</p>
            <div class="mt-4 pt-4 border-t border-border">
              <span class="text-sm font-semibold text-primary">{c.result}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
