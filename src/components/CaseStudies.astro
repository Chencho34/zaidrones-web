---
const cases = [
  {
    line: "Vigilancia 24/7",
    client: "Parque Industrial Monterrey",
    service: "Dock 3 + centro de monitoreo",
    description: "Patrullaje autónomo de 50 hectáreas con verificación de incidentes en tiempo real.",
    result: "−70% incidentes de seguridad",
  },
  {
    line: "Servicios",
    client: "Constructora Regional",
    service: "Ortomosaico semanal",
    description: "Seguimiento de avance de obra con mapas aéreos georreferenciados de alta resolución.",
    result: "120 horas hombre/mes ahorradas",
  },
  {
    line: "Equipo",
    client: "Planta Energética",
    service: "Flota Matrice 4T + Pix4D",
    description: "Adquisición de flota enterprise y software para inspección térmica interna.",
    result: "Equipo operativo en 3 semanas",
  },
];
---

<section id="proyectos" class="py-20 md:py-28 bg-background-light">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14">
      <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-text-secondary mb-4">
        Resultados
      </p>
      <h2 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl lg:text-5xl">
        Un caso por línea de negocio
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Cómo se ve cada camino cuando ya está en operación.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-px bg-border">
      {cases.map((c) => (
        <article class="bg-background-light p-8 hover:bg-white transition-colors">
          <p class="font-mono text-[11px] tracking-[0.16em] uppercase text-primary-muted">{c.line}</p>
          <h3 class="mt-5 text-xl font-semibold text-text">{c.service}</h3>
          <p class="mt-1 text-sm text-text-secondary">{c.client}</p>
          <p class="mt-4 text-sm text-text-secondary leading-relaxed">{c.description}</p>
          <p class="mt-6 pt-5 border-t border-border font-mono text-sm text-primary-muted">{c.result}</p>
        </article>
      ))}
    </div>
  </div>
</section>
