---
const services = [
  {
    index: "01",
    title: "Ortomosaico",
    description: "Mapas aéreos georreferenciados de alta resolución para topografía, construcción y planeación.",
  },
  {
    index: "02",
    title: "Nube de puntos",
    description: "Modelos 3D densos y georreferenciados con LiDAR y fotogrametría para mediciones exactas.",
  },
  {
    index: "03",
    title: "Inspección",
    description: "Evaluación aérea de infraestructura: chimeneas, aerogeneradores, líneas eléctricas y más.",
  },
  {
    index: "04",
    title: "Monitoreo de seguridad",
    description: "Vigilancia aérea puntual en tiempo real con cámara térmica para eventos y obras.",
  },
  {
    index: "05",
    title: "Foto y video aéreo",
    description: "Contenido visual profesional para documentar avances de obra y marketing.",
  },
  {
    index: "06",
    title: "Capacitación",
    description: "Formación teórica y práctica en pilotaje y operación de drones para su equipo.",
  },
  {
    index: "07",
    title: "Consultoría",
    description: "Asesoría especializada para optimizar procesos con tecnología de drones.",
  },
];
---

<section id="servicios" class="py-20 md:py-28 bg-background-light">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14">
      <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-text-secondary mb-4">
        Por proyecto
      </p>
      <h2 class="text-3xl font-semibold tracking-tight text-text sm:text-4xl lg:text-5xl">
        Servicios profesionales con drones
      </h2>
      <p class="mt-4 text-lg text-text-secondary leading-relaxed">
        Capturamos datos aéreos y los convertimos en información accionable. No necesita comprar equipo.
      </p>
    </div>

    <ul class="grid sm:grid-cols-2 border-t border-border">
      {services.map((service) => (
        <li class="group border-b border-border sm:odd:border-r">
          <a href="#contacto" class="flex flex-col h-full p-6 sm:p-8 transition-colors hover:bg-white">
            <span class="font-mono text-[11px] tracking-[0.18em] text-primary-muted">{service.index}</span>
            <h3 class="mt-4 text-xl font-semibold text-text">{service.title}</h3>
            <p class="mt-2 text-sm text-text-secondary leading-relaxed flex-1">{service.description}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-mono text-xs tracking-[0.14em] uppercase text-text-secondary group-hover:text-primary-muted group-hover:gap-3 transition-all">
              Cotizar
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
