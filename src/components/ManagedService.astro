---
import Badge from "./ui/Badge.astro";
import Button from "./ui/Button.astro";

const steps = [
  {
    number: "01",
    title: "Instalación",
    description: "Instalamos y configuramos el DJI Dock 3 en las instalaciones de su empresa.",
  },
  {
    number: "02",
    title: "Programación",
    description: "Definimos rutas de patrullaje autónomas para perímetros, accesos y áreas críticas.",
  },
  {
    number: "03",
    title: "Monitoreo",
    description: "Pilotos especializados monitorean en tiempo real desde nuestro Centro de Monitoreo.",
  },
  {
    number: "04",
    title: "Verificación",
    description: "Ante cualquier evento, el dron despega automáticamente para inspeccionar.",
  },
  {
    number: "05",
    title: "Notificación",
    description: "Alertamos inmediatamente al personal de seguridad de su organización.",
  },
  {
    number: "06",
    title: "Reporte",
    description: "El dron regresa al Dock a recargar y generamos reportes de cada operación.",
  },
];
---

<section id="servicio-administrado" class="py-20 md:py-28 bg-background-dark text-text-inverse relative overflow-hidden">
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-accent/10 rounded-full blur-3xl"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <Badge variant="primary" class="mb-4 !bg-accent/15 !text-accent">Servicio Premium</Badge>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
        Vigilancia Aérea 24/7
      </h2>
      <p class="mt-4 text-lg text-text-inverse/70 max-w-2xl mx-auto">
        Instalamos el DJI Dock 3, programamos las rutas y operamos el monitoreo 24/7 desde nuestro centro.
      </p>
    </div>

    <div
      class="relative mb-12 outline-none"
      tabindex="0"
      role="region"
      aria-roledescription="carrusel"
      aria-label="Pasos del servicio administrado"
    >
      <button
        type="button"
        data-ms-prev
        class="absolute left-0 top-1/2 z-10 -translate-y-1/2 -translate-x-1 sm:-translate-x-3 flex items-center justify-center w-10 h-10 rounded-full border border-text-inverse/20 bg-background-dark/80 text-text-inverse backdrop-blur-sm transition-colors hover:border-accent hover:text-accent disabled:opacity-30 disabled:pointer-events-none disabled:hover:border-text-inverse/20 disabled:hover:text-text-inverse"
        aria-label="Paso anterior"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        type="button"
        data-ms-next
        class="absolute right-0 top-1/2 z-10 -translate-y-1/2 translate-x-1 sm:translate-x-3 flex items-center justify-center w-10 h-10 rounded-full border border-text-inverse/20 bg-background-dark/80 text-text-inverse backdrop-blur-sm transition-colors hover:border-accent hover:text-accent disabled:opacity-30 disabled:pointer-events-none disabled:hover:border-text-inverse/20 disabled:hover:text-text-inverse"
        aria-label="Paso siguiente"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div data-ms-track class="ms-track flex gap-6 overflow-x-auto snap-x snap-mandatory pb-2">
        {steps.map((step) => (
          <article
            data-ms-card
            class="snap-start shrink-0 w-[calc(100%-2.75rem)] sm:w-[360px] lg:w-[380px] group relative rounded-xl border border-text-inverse/10 bg-text-inverse/5 p-6 hover:border-accent/30 transition-all duration-300"
          >
            <span class="text-4xl font-extrabold text-accent/40 group-hover:text-accent transition-colors">
              {step.number}
            </span>
            <h3 class="mt-3 text-lg font-bold text-text-inverse">
              {step.title}
            </h3>
            <p class="mt-2 text-sm text-text-inverse/60 leading-relaxed">
              {step.description}
            </p>
          </article>
        ))}
      </div>

      <div class="mt-8 flex items-center justify-center gap-2" role="tablist" aria-label="Ir a un paso">
        {steps.map((step, i) => (
          <button
            type="button"
            data-ms-dot
            aria-label={`Ir al paso ${step.number}: ${step.title}`}
            aria-current={i === 0 ? "true" : "false"}
            class:list={[
              "h-2 rounded-full transition-all duration-300",
              i === 0 ? "w-6 bg-accent" : "w-2 bg-text-inverse/20 hover:bg-text-inverse/40",
            ]}
          />
        ))}
      </div>
    </div>

    <div class="text-center">
      <Button href="#contacto" variant="primary" class="text-base px-8 py-4 !bg-accent !text-background-dark hover:!bg-primary-hover hover:!shadow-accent/20">
        Solicitar Demo Gratuita
      </Button>   
    </div>
  </div>
</section>

<style>
  .ms-track {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ms-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const root = document.getElementById("servicio-administrado");
  const track = root?.querySelector<HTMLElement>("[data-ms-track]");
  const cards = [...(root?.querySelectorAll<HTMLElement>("[data-ms-card]") ?? [])];
  const prev = root?.querySelector<HTMLButtonElement>("[data-ms-prev]");
  const next = root?.querySelector<HTMLButtonElement>("[data-ms-next]");
  const dots = [...(root?.querySelectorAll<HTMLButtonElement>("[data-ms-dot]") ?? [])];
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const getIndex = () => {
    if (!track || !cards.length) return 0;
    const origin = track.getBoundingClientRect().left;
    let closest = 0;
    let min = Infinity;
    cards.forEach((card, i) => {
      const dist = Math.abs(card.getBoundingClientRect().left - origin);
      if (dist < min) {
        min = dist;
        closest = i;
      }
    });
    return closest;
  };

  const goTo = (index: number) => {
    if (!track) return;
    const i = Math.max(0, Math.min(index, cards.length - 1));
    const card = cards[i];
    if (!card) return;
    const left = card.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft;
    track.scrollTo({ left, behavior: reduceMotion ? "auto" : "smooth" });
  };

  const sync = () => {
    const i = getIndex();
    prev && (prev.disabled = i <= 0);
    next && (next.disabled = i >= cards.length - 1);
    dots.forEach((dot, di) => {
      const active = di === i;
      dot.setAttribute("aria-current", String(active));
      dot.classList.toggle("w-6", active);
      dot.classList.toggle("bg-accent", active);
      dot.classList.toggle("w-2", !active);
      dot.classList.toggle("bg-text-inverse/20", !active);
    });
  };

  track?.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
  prev?.addEventListener("click", () => goTo(getIndex() - 1));
  next?.addEventListener("click", () => goTo(getIndex() + 1));
  dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

  root?.addEventListener("keydown", (e) => {
    if (e.key === "ArrowLeft") {
      e.preventDefault();
      goTo(getIndex() - 1);
    }
    if (e.key === "ArrowRight") {
      e.preventDefault();
      goTo(getIndex() + 1);
    }
  });

  sync();
</script>
