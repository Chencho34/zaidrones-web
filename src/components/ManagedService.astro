---
import Button from "./ui/Button.astro";

const steps = [
  {
    number: "01",
    title: "Instalación",
    description: "Instalamos y configuramos el DJI Dock 3 en las instalaciones de su empresa.",
  },
  {
    number: "02",
    title: "Programación",
    description: "Definimos rutas de patrullaje autónomas para perímetros, accesos y áreas críticas.",
  },
  {
    number: "03",
    title: "Monitoreo",
    description: "Pilotos especializados vigilan en tiempo real desde nuestro Centro de Monitoreo.",
  },
  {
    number: "04",
    title: "Verificación",
    description: "Ante cualquier evento, el dron despega automáticamente para inspeccionar.",
  },
  {
    number: "05",
    title: "Notificación",
    description: "Alertamos de inmediato al personal de seguridad de su organización.",
  },
  {
    number: "06",
    title: "Reporte",
    description: "El dron regresa al Dock a recargar. Entregamos reporte de cada operación.",
  },
];
---

<section id="servicio-administrado" class="py-20 md:py-28 bg-background-dark text-text-inverse relative overflow-hidden">
  <div class="absolute top-1/3 right-0 w-[480px] h-[480px] bg-accent/8 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-12 lg:gap-20 items-start">
      <div class="lg:sticky lg:top-28">
        <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-accent mb-4">
          02 / Servicio premium
        </p>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-[2.75rem] lg:leading-[1.15]">
          No solo instalamos un drone.
          <span class="block text-accent mt-2">Administramos toda la operación.</span>
        </h2>
        <p class="mt-6 text-base text-text-inverse/65 leading-relaxed max-w-md">
          Instalamos el DJI Dock 3, programamos las rutas y operamos el monitoreo 24/7 desde nuestro centro. Usted recibe evidencia, no una caja.
        </p>
        <Button
          href="#contacto"
          variant="primary"
          class="mt-10 text-base px-8 py-4 !bg-accent !text-background-dark hover:!bg-primary-hover hover:!shadow-accent/20"
        >
          Solicitar demo gratuita
        </Button>
      </div>

      <ol class="relative border-l border-white/15 ml-3 sm:ml-4">
        {steps.map((step) => (
          <li class="relative pl-8 sm:pl-10 pb-10 last:pb-0">
            <span class="absolute -left-[5px] top-1.5 size-2.5 bg-accent" aria-hidden="true"></span>
            <p class="font-mono text-[11px] tracking-[0.18em] text-accent/80">{step.number}</p>
            <h3 class="mt-1 text-xl font-semibold text-text-inverse">{step.title}</h3>
            <p class="mt-2 text-sm text-text-inverse/60 leading-relaxed max-w-md">
              {step.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
