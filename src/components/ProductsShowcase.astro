---
const products = [
  {
    name: "DJI Matrice 400",
    tagline: "Plataforma industrial de alto rendimiento",
    specs: ["Carga útil: hasta 6 kg", "Vuelo: hasta 59 min", "Altitud: 7,000 m", "Viento: 12 m/s"],
    badge: "Inspección",
  },
  {
    name: "DJI Matrice 4T",
    tagline: "Multisensor para cualquier misión",
    specs: ["RGB + Térmica + Telémetro", "Vuelo: hasta 49 min", "Altitud: 6,000 m", "Versatilidad total"],
    badge: "Más vendido",
  },
  {
    name: "DJI Matrice 4E",
    tagline: "Precisión geoespacial extrema",
    specs: ["Cámara gran angular", "Teleobjetivo integrado", "Telémetro láser", "Cartografía profesional"],
    badge: "Geoespacial",
  },
  {
    name: "DJI Dock 3",
    tagline: "Estación autónoma para operaciones 24/7",
    specs: ["IP56 resistente a clima", "Rango: -30°C a 50°C", "55 kg de peso", "Retorno automático"],
    badge: "24/7",
  },
  {
    name: "PIX4Dmapper",
    tagline: "Fotogrametría profesional, distribución oficial",
    specs: ["Captura → modelo 3D", "Medición e inspección", "Control de calidad", "Prueba 15 días"],
    badge: "Software",
  },
];
---

<section id="equipo" class="py-20 md:py-28 bg-background-dark text-text-inverse relative overflow-hidden">
  <div class="absolute top-0 right-0 w-96 h-96 bg-accent/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mb-14">
      <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-accent mb-4">
        Distribuidor oficial
      </p>
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl lg:text-5xl">
        Equipo DJI Enterprise y Pix4D
      </h2>
      <p class="mt-4 text-lg text-text-inverse/65">
        Hardware industrial y software de fotogrametría. Soporte técnico en cada compra.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-px bg-white/10">
      {products.map((product) => (
        <article class="bg-background-dark p-8 hover:bg-white/[0.03] transition-colors">
          <div class="flex items-start justify-between gap-4 mb-5">
            <div>
              <h3 class="text-2xl font-semibold text-text-inverse">{product.name}</h3>
              <p class="text-text-inverse/55 mt-1 text-sm">{product.tagline}</p>
            </div>
            <span class="shrink-0 font-mono text-[10px] tracking-[0.16em] uppercase text-accent border border-accent/40 px-2 py-1">
              {product.badge}
            </span>
          </div>
          <ul class="grid grid-cols-2 gap-3">
            {product.specs.map((spec) => (
              <li class="flex items-start gap-2 text-sm text-text-inverse/70">
                <span class="text-accent mt-0.5" aria-hidden="true">▸</span>
                {spec}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
