---
import SectionHeader from "./ui/SectionHeader.astro";

const clients = [
  "Implang",
  "TecMonterrey",
  "Cemex",
  "Femsa",
  "Alfa",
  "Banorte",
  "CFE",
  "Chencho",
  "Heineken",
  "UANL",
  "Tyasa",
  "Ternium",
];
---

<section>
  <article>
    <div class="inline-flex items-center gap-2 mb-7 px-3.5 py-1.5 frame" style="--fc: rgba(193,255,114,0.35);">
      <span class="relative inline-flex w-1.5 h-1.5">
        <span class="pulse-dot absolute inset-0"></span>
        <span class="relative w-1.5 h-1.5 rounded-full bg-[#C1FF72]"></span>
      </span>
      <span
        class="font-mono text-[11px] tracking-[0.18em] text-[#C1FF72] uppercase"
      >
        Capacitación certificada DJI
      </span>
    </div>

    <h2 class="font-display font-semibold text-[2rem] sm:text-[2.75rem] leading-[1.15] text-white tracking-tight">
      Certificamos a tu equipo con los mismos
      <span class="text-[#C1FF72]">estándares</span>
      que exige la industria
    </h2>

    <p class="mt-5 font-body text-base sm:text-lg text-white/55 leading-relaxed">
      Formación oficial DJI, actualización constante y soporte técnico dedicado,
      para que tu talento esté tan preparado como tu flota.
    </p>
    <a
      href="#"
      class="mt-7 inline-flex items-center gap-2 font-mono text-sm text-white/80 hover:text-[#C1FF72] transition-colors group"
    >
      Conocer el programa de capacitación
      <span class="transition-transform group-hover:translate-x-1">→</span>
    </a>
  </article>
  <div class="reveal flex items-center gap-4 mb-16 max-w-4xl mx-auto" style="transition-delay:.05s">
    <span class="h-px flex-1 bg-white/10"></span>
    <span class="w-1.5 h-1.5 rotate-45 border border-white/25"></span>
    <span class="h-px flex-1 bg-white/10"></span>
  </div>


   <div class="reveal grid grid-cols-2 lg:grid-cols-4 border-t border-b border-white/10 divide-x divide-white/10" style="transition-delay:.15s">
      <div class="px-4 py-8 text-center">
        <p class="font-mono font-medium text-3xl sm:text-4xl text-white">+300</p>
        <p class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase">Clientes satisfechos</p>
      </div>
      <div class="px-4 py-8 text-center">
        <p class="font-mono font-medium text-3xl sm:text-4xl text-white">+12</p>
        <p class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase">Años de experiencia</p>
      </div>
      <div class="px-4 py-8 text-center">
        <p class="font-mono font-medium text-3xl sm:text-4xl text-white">24/7</p>
        <p class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase">Monitoreo continuo</p>
      </div>
      <div class="px-4 py-8 text-center">
        <p class="font-mono font-medium text-3xl sm:text-4xl text-[#C1FF72]">100%</p>
        <p class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase">Cobertura nacional</p>
      </div>
    </div>
</section>

<!-- ============ SECCIÓN ============ -->
<section class="relative bg-background-dark overflow-hidden">
  <!-- fondo: grid de telemetría sutil -->
  <!-- <div class="absolute inset-0 telemetry-grid"></div> -->

  <!-- fondo: barrido de radar detrás del encabezado -->
  <!-- <div class="pointer-events-none absolute left-1/2 top-24 -translate-x-1/2 w-[640px] h-[640px] rounded-full radar blur-2xl" aria-hidden="true"></div> -->

  <div class="relative max-w-6xl mx-auto px-6 pt-24 pb-20 sm:pt-28 sm:pb-24">
    <!-- ===== Encabezado ===== -->
    <div class="reveal max-w-2xl mx-auto text-center mb-20">
      <!-- eyebrow estilo etiqueta HUD -->
      <div
        class="inline-flex items-center gap-2 mb-7 px-3.5 py-1.5 frame"
        style="--fc: rgba(193,255,114,0.35);"
      >
        <span class="relative inline-flex w-1.5 h-1.5">
          <span class="pulse-dot absolute inset-0"></span>
          <span class="relative w-1.5 h-1.5 rounded-full bg-[#C1FF72]"></span>
        </span>
        <span
          class="font-mono text-[11px] tracking-[0.18em] text-[#C1FF72] uppercase"
        >
          Capacitación certificada DJI
        </span>
      </div>
      <h2
        class="font-display font-semibold text-[2rem] sm:text-[2.75rem] leading-[1.15] text-white tracking-tight"
      >
        Certificamos a tu equipo con los mismos
        <span class="text-[#C1FF72]"> estándares </span>
        que exige la industria
      </h2>

      <p
        class="mt-5 font-body text-base sm:text-lg text-white/55 leading-relaxed"
      >
        Formación oficial DJI, actualización constante y soporte técnico
        dedicado, para que tu talento esté tan preparado como tu flota.
      </p>
      <a
        href="#"
        class="mt-7 inline-flex items-center gap-2 font-mono text-sm text-white/80 hover:text-[#C1FF72] transition-colors group"
      >
        Conocer el programa de capacitación
        <span class="transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>

    <!-- ===== Divisor con marca central ===== -->
    <div
      class="reveal flex items-center gap-4 mb-16 max-w-6xl mx-auto"
      style="transition-delay:.05s"
    >
      <span class="h-px flex-1 bg-white/10"></span>
      <span class="w-1.5 h-1.5 rotate-45 border border-white/25"></span>
      <span class="h-px flex-1 bg-white/10"></span>
    </div>

    <!-- <div class="border-t  border-white/10 divide-x divide-white/10"></div> -->

    <!-- ===== Logos (fila estática) ===== -->
    <div class="reveal mb-16 style=" transition-delay:.1s">
      <p
        class="text-center font-mono text-[11px] tracking-[0.18em] text-white/35 uppercase mb-9"
      >
        Empresas que ya confían en nuestra tecnología
      </p>
    </div>
    <div class="mt-16">
      <section class="pt- border-text-inverse/10 bg-background-dark">
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <!-- Logos marquee -->
          <div class="marquee relative w-full overflow-hidden">
            <div class="marquee__track flex w-max items-center">
              <!-- Grupo 1 -->
              <div
                class="marquee__group flex items-center gap-x-12 pr-12"
                aria-hidden="false"
              >
                {
                  clients.map((client) => (
                    <div class="relative font-sans text-xl font-bold tracking-wide group isolate flex aspect-[16/10] shrink-0 items-center justify-center rounded-md text-text-inverse/70 transition duration-500 outline-none hover:-translate-y-1 focus-visible:-translate-y-1 focus-visible:ring-2 w-[150px] hover:text-white cursor-pointer">
                      {client}
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-1.5 left-1.5 size-2.5 border-t border-l border-accent/35 transition duration-500 group-hover:border-accent group-focus-visible:border-accent sm:top-2 sm:left-2 sm:size-3"
                      />
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-1.5 right-1.5 size-2.5 border-t border-r border-accent/35 transition duration-500 group-hover:border-accent group-focus-visible:border-accent sm:top-2 sm:right-2 sm:size-3"
                      />
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-1.5 left-1.5 size-2.5 border-b border-l border-accent/35 transition duration-500 group-hover:border-accent group-focus-visible:border-accent sm:bottom-2 sm:left-2 sm:size-3"
                      />
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute right-1.5 bottom-1.5 size-2.5 border-r border-b border-accent/35 transition duration-500 group-hover:border-accent group-focus-visible:border-accent sm:right-2 sm:bottom-2 sm:size-3"
                      />
                    </div>
                  ))
                }
              </div>

              <!-- Grupo 2 (duplicado, oculto a lectores de pantalla, cierra el loop) -->
              <div
                class="marquee__group flex items-center gap-x-12 pr-12"
                aria-hidden="true"
              >
                {
                  clients.map((client) => (
                    <div class="relative font-sans text-xl font-bold tracking-wide group isolate flex aspect-[16/10] shrink-0 items-center justify-center rounded-md text-text-inverse/70 transition duration-500 outline-none w-[150px] hover:text-white cursor-pointer">
                      {client}
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-1.5 left-1.5 size-2.5 border-t border-l border-accent/35 sm:top-2 sm:left-2 sm:size-3"
                      />
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute top-1.5 right-1.5 size-2.5 border-t border-r border-accent/35 sm:top-2 sm:right-2 sm:size-3"
                      />
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute bottom-1.5 left-1.5 size-2.5 border-b border-l border-accent/35 sm:bottom-2 sm:left-2 sm:size-3"
                      />
                      <span
                        aria-hidden="true"
                        class="pointer-events-none absolute right-1.5 bottom-1.5 size-2.5 border-r border-b border-accent/35 sm:right-2 sm:bottom-2 sm:size-3"
                      />
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>

  <!-- ===== Panel de estadísticas (estilo telemetría) ===== -->
  <div
    class="reveal grid grid-cols-2 lg:grid-cols-4 border-t border-b border-white/10 divide-x divide-white/10"
    style="transition-delay:.15s"
  >
    <div class="px-4 py-8 text-center">
      <p class="font-mono font-medium text-3xl sm:text-4xl text-white">+300</p>
      <p
        class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase"
      >
        Clientes satisfechos
      </p>
    </div>
    <div class="px-4 py-8 text-center">
      <p class="font-mono font-medium text-3xl sm:text-4xl text-white">+12</p>
      <p
        class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase"
      >
        Años de experiencia
      </p>
    </div>
    <div class="px-4 py-8 text-center">
      <p class="font-mono font-medium text-3xl sm:text-4xl text-white">24/7</p>
      <p
        class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase"
      >
        Monitoreo continuo
      </p>
    </div>
    <div class="px-4 py-8 text-center">
      <p class="font-mono font-medium text-3xl sm:text-4xl text-[#C1FF72]">
        100%
      </p>
      <p
        class="mt-2 font-mono text-[11px] tracking-[0.14em] text-white/40 uppercase"
      >
        Cobertura nacional
      </p>
    </div>
  </div>
</section>

<style>
  .marquee {
    --fade-size: 100px;
    --speed: 32s;

    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade-size),
      #000 calc(100% - var(--fade-size)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 var(--fade-size),
      #000 calc(100% - var(--fade-size)),
      transparent 100%
    );
  }

  .marquee__track {
    animation: marquee-scroll 32s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
    .marquee {
      overflow-x: auto;
    }
  }
</style>
