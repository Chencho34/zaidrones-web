---
import { heroPaths } from "../constants";
import bgHeroVideo from "../assets/videos/hero-bg-video.mp4";
---

<section class="relative min-h-screen flex flex-col justify-end overflow-hidden">
  <div class="absolute inset-0">
    <video
      id="hero-video"
      src={bgHeroVideo}
      class="w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-background-dark/45"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-background-dark/55 via-background-dark/70 to-background-dark"></div>
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8 pt-28">
    <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-accent animate-fade-in">
      Distribuidor oficial DJI Enterprise · México
    </p>

    <h1 class="mt-5 max-w-4xl text-4xl font-extrabold tracking-tight text-text-inverse sm:text-5xl md:text-6xl lg:text-[4.25rem] lg:leading-[1.05] animate-slide-up">
      Drones profesionales para industria, datos y seguridad.
    </h1>

    <p class="mt-6 max-w-xl text-base sm:text-lg text-text-inverse/70 leading-relaxed animate-slide-up" style="animation-delay: 0.1s;">
      Equipo DJI y Pix4D. Servicios de captura aérea. Vigilancia 24/7 administrada. Un solo socio, +12 años en Monterrey.
    </p>

    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-mono text-[11px] tracking-[0.14em] uppercase text-text-inverse/55 animate-fade-in" style="animation-delay: 0.2s;">
      <li class="flex items-center gap-2">
        <span class="size-1.5 bg-accent" aria-hidden="true"></span>
        DJI Enterprise
      </li>
      <li class="flex items-center gap-2">
        <span class="size-1.5 bg-accent" aria-hidden="true"></span>
        +12 años
      </li>
      <li class="flex items-center gap-2">
        <span class="size-1.5 bg-accent" aria-hidden="true"></span>
        +300 clientes
      </li>
    </ul>

    <nav class="mt-36 grid grid-cols-1 md:grid-cols-3 border-t border-white/15" aria-label="Elegir un camino">
      {heroPaths.map((path) => (
        <a
          href={path.href}
          class:list={[
            "group relative flex flex-col justify-between gap-6 px-5 py-6 sm:px-7 sm:py-8 border-b md:border-b-0 md:border-r border-white/15 last:border-0 transition-colors duration-300",
            path.featured ? "bg-accent/8 hover:bg-accent/14" : "hover:bg-white/5",
          ]}
        >
          <div class="flex items-center justify-between">
            <span class="font-mono text-[11px] tracking-[0.18em] uppercase text-accent">{path.index}</span>
            <span class="font-mono text-[11px] tracking-[0.18em] uppercase text-white/40 group-hover:text-accent transition-colors">
              {path.label}
            </span>
          </div>
          <div class="flex items-end justify-between gap-4">
            <span class="text-lg sm:text-xl font-semibold text-text-inverse leading-snug">
              {path.title}
            </span>
            <span class="shrink-0 text-accent transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
              →
            </span>
          </div>
        </a>
      ))}
    </nav>
  </div>
</section>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  if (video && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    video.pause();
  }
</script>
