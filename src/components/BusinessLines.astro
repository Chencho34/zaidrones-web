---
import SectionHeader from "./ui/SectionHeader.astro";
import { BusinnesLines } from "../constants";
import CardBusinessLine from "./ui/CardBusinessLine.astro";
---

<section id="lineas-negocio" class="relative py-20 md:py-28 bg-background">  
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      title="Tres líneas. Un solo socio estratégico."
      subtitle="Desde la venta de equipo hasta la operación completa de seguridad aérea."
    />
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6 mt-20">
      {
        BusinnesLines.map((line) => (
          <CardBusinessLine
            img={line.img}
            title={line.title}
            description={line.description}
            features={line.features}
            href={line.href}
            icon={line.icon}          
          />
        ))
      }
    </div>
  </div>
</section>
