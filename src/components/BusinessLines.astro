---
import { businessLines } from "../constants";
import CardBusinessLine from "./ui/CardBusinessLine.astro";
---

<section id="lineas-negocio" class="relative py-20 md:py-28 bg-background-light">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <article class="reveal max-w-2xl mb-14">
      <p class="font-mono text-[11px] tracking-[0.22em] uppercase text-text-secondary mb-4">
        01 / Mapa
      </p>
      <h2 class="font-semibold text-[2rem] sm:text-[2.75rem] leading-[1.15] text-text tracking-tight">
        Tres líneas. Un solo socio.
      </h2>
      <p class="mt-5 text-base sm:text-lg text-text-secondary leading-relaxed">
        Compre equipo, contrate un levantamiento o deje la vigilancia en nuestras manos.
      </p>
    </article>

    <div class="mx-auto grid grid-cols-1 md:grid-cols-3 gap-5">
      {businessLines.map((line) => (
        <CardBusinessLine
          img={line.img}
          index={line.index}
          title={line.title}
          description={line.description}
          features={line.features}
          href={line.href}
          icon={line.icon}
          badge={line.badge}
          featured={line.featured}
        />
      ))}
    </div>
  </div>
</section>
