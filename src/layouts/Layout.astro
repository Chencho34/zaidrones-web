---
import "../styles/global.css"

import '@fontsource-variable/ibm-plex-sans/index.css'
import '@fontsource-variable/onest/wght.css'

import { Footer, Header, BaseHead } from "../components/layout"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
---

<!doctype html>
<html lang="es-MX">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body class="bg-background-light antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[60] focus:bg-accent focus:text-background-dark focus:px-4 focus:py-2 focus:font-semibold"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
